{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-vercel"
      ],
      "env": {
        "VERCEL_MCP_SERVER_URL": "https://mcp.vercel.com"
      }
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-supabase"
      ],
      "env": {
        "SUPABASE_MCP_SERVER_URL": "https://mcp.supabase.com/mcp?project_ref=mdkruymhqtxiyaveqrul&read_only=true"
      }
    }
  }
}
